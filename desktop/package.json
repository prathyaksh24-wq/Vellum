{
  "name": "vellum-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Vellum desktop workspace",
  "author": "Vellum",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "node scripts/start.cjs --watch .",
    "start": "node scripts/start.cjs .",
    "build": "node scripts/build-ui.cjs",
    "build:backend": "node scripts/build-backend.cjs",
    "build:engines": "node scripts/build-engines.cjs",
    "package": "node scripts/build-ui.cjs && node scripts/build-backend.cjs && node scripts/build-engines.cjs && electron-forge package",
    "make": "node scripts/build-ui.cjs && node scripts/build-backend.cjs && node scripts/build-engines.cjs && electron-forge make",
    "release": "node scripts/release.cjs",
    "install-app": "node scripts/install-app.cjs",
    "test": "node --test test/*.test.cjs",
    "smoke": "node scripts/smoke.cjs",
    "smoke:browser": "node scripts/native-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.10.1",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1"
  }
}
