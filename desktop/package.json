{
  "name": "vellum-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Vellum desktop workspace",
  "author": "Vellum",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "node scripts/build-ui.cjs",
    "package": "node scripts/build-ui.cjs && electron-forge package",
    "make": "node scripts/build-ui.cjs && electron-forge make",
    "test": "node --test test/*.test.cjs",
    "smoke": "node scripts/smoke.cjs",
    "smoke:browser": "node scripts/native-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1"
  }
}
