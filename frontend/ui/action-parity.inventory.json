  "exemptions": [
    {"scope":"More sidebar disclosure, browser address and homepage form drafts, engine and session menu visibility, downloads disclosure and browser expansion","reason":"Temporary, reversible presentation and input drafts only; navigation, engine selection, SearXNG instance and shortcut mutations use browser.session.control and panel visibility uses the Workspace Layout owner."},
    {"scope":"scroll, pointer hover, focus and text selection","reason":"Input/navigation gesture only; does not commit product state."},
    {"scope":"draft typing and in-view search filters","reason":"No committed product state; a separate save or submit control commits the change."},
    {"scope":"tooltips, transient pickers and discard prompts","reason":"Non-persistent presentation only; the underlying committed action is reviewed separately."},
    {"scope":"book shelf rotation and page navigation","reason":"Presentation/reading gestures only; processing and compiling remain App Actions."},
    {"scope":"Calendar refresh, calendar selection, event search and proposed-slot drafts","reason":"Read-only provider requests or staged form choices; confirmed event mutations use the Calendar App Actions listed above."}
  ],
  "deferred": [
    {"surface":"Main Library local notes and project cards","reason":"Legacy local collection mutations still use setLibrary/setProjects; no corresponding App Action definitions."},
    {"surface":"Agent profile enablement and settings","reason":"The specialist On/Off control and settings modal still edit local agentCfg instead of a canonical agent-setting App Action."},
    {"surface":"Chat connector selection and custom instructions","reason":"Per-chat app selection, connector-ready badges and custom instructions still update client state without a persisted App Action receipt."},
    {"surface":"Dictation and experimental dev mode","reason":"Composer dictation is currently a local presentation toggle, and the dev-mode shortcut is session-only; neither has a runtime action contract."},
    {"surface":"Coding workspace local configuration","reason":"Model, reasoning, access, layout and session controls in the separate coding page are local or coding-API state, not App Action receipts."},
    {"surface":"GitHub PR creation visual control","reason":"The backend action exists but this UI has no create-PR control; only PR open is wired in the coding workspace."},
    {"surface":"Third-party connector operations","reason":"Discord and X Agent Reach/optional OAuth setup still use plugin-specific API contracts. Generic App Action parity is deferred for those operations; Calendar connection/event writes and Spotify connection/player-session writes are covered above."},
    {"surface":"Legacy design previews and setup flow","reason":"Not the production entry point; excluded from the served-control lock pending migration or removal."}
  ]
